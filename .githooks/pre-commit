#!/bin/sh
set -e

STAGED=$(git diff --cached --name-only --diff-filter=d)

# ESLint on staged JS/TS/TSX files
JS_FILES=$(printf '%s\n' "$STAGED" | grep -E '\.(js|ts|tsx|jsx)$' || true)
if [ -n "$JS_FILES" ]; then
    npx eslint $JS_FILES
fi

# JSON validation on staged JSON files (exclude tsconfig*.json)
JSON_FILES=$(printf '%s\n' "$STAGED" | grep '\.json$' | grep -v 'tsconfig.*\.json' || true)
if [ -n "$JSON_FILES" ]; then
    python3 .githooks/validate_staged_json.py $JSON_FILES
fi
